# Global Watch settings. This file holds secrets: never share it or commit it.
SERPAPI_KEY=your-serpapi-key
LUMINAL_API_KEY=your-luminal-key

# Luminal's Text API isn't publicly documented. The app tries the likely addresses on its own.
# If AI shows OFFLINE, ask Luminal for the OpenAI-compatible base URL and model name and put them here:
LUMINAL_TEXT_BASE_URL=
LUMINAL_TEXT_MODEL=

# Falls back to a local Ollama (http://127.0.0.1:11434) if Luminal doesn't answer. Set to 0 to disable.
OLLAMA_FALLBACK=1
OLLAMA_MODEL=

# Live ships: free key from https://aisstream.io (sign in with GitHub). Needs Node.js 22+.
AISSTREAM_KEY=

# Optional: free OpenSky API client for more aircraft refreshes (anonymous ≈ 100 world snapshots/day).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_REFRESH_SECONDS=60

PORT=8787
# Set HOST=0.0.0.0 and APP_PASSWORD when hosting publicly.
HOST=127.0.0.1
APP_PASSWORD=
# MOCK=1 shows sample data and makes no API calls.
MOCK=0
